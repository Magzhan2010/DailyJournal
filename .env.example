# Frontend environment
# Leave VITE_API_URL empty to use the Vite dev proxy (see vite.config.js),
# which forwards /journal -> http://127.0.0.1:8000/journal (no CORS needed).
#
# For production set the absolute URL of your deployed backend:
# VITE_API_URL=https://api.my-note.app

# Force the app to run without a backend (data is kept in localStorage)
# VITE_USE_LOCAL=true
