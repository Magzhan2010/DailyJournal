# Production API host.
#
# Leave it empty when the frontend and the API sit on the same origin
# (vercel.json proxies /journal to the backend for you).
#
# If they live on different domains, set the absolute URL here AND allow that
# origin in the backend's CORS middleware:
#
#   VITE_API_URL=https://my-note-api.onrender.com
VITE_API_URL=

# Set to true to force the browser-only mode (entries stay in localStorage).
VITE_USE_LOCAL=false
