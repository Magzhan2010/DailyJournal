{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/journal/:path*",
      "destination": "https://my-note-api.onrender.com/journal/:path*"
    },
    {
      "source": "/((?!journal).*)",
      "destination": "/index.html"
    }
  ]
}
